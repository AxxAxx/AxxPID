{
  "name": "AxxPID",
  "version": "1.0.0",
  "description": "Portable, dependency-free PID controller for C. Feed-forward, two-degree-of-freedom setpoint weighting, filtered derivative, selectable anti-windup, bumpless transfer, slew limiting, and a relay autotuner. No dependencies, no dynamic allocation.",
  "keywords": ["pid", "control", "controller", "feedforward", "autotune", "pid-controller", "temperature", "motor", "embedded", "c99", "arm", "riscv", "avr", "stm32", "arduino", "esp32", "portable"],
  "license": "MIT",
  "authors": [
    {
      "name": "Axel Johansson",
      "email": "axeljohansson@duck.com",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AxxAxx/AxxPID.git"
  },
  "frameworks": "*",
  "platforms": "*",
  "headers": "axxpid/axxpid.h",
  "export": {
    "exclude": ["build", "docs/html", "*.exe"]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "include"
  },
  "examples": [
    "examples/*.c",
    "examples/arduino/*/*.ino"
  ]
}
